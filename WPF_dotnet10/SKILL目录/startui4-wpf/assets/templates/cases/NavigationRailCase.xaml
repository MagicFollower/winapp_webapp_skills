<UserControl x:Class="__APPNAME__.Views.NavigationRailCase"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:StartUI4Controls;assembly=StartUI4Controls"
             xmlns:views="clr-namespace:__APPNAME__.Views"
             FontFamily="{DynamicResource UI4.Font.Family}"
             FontSize="{DynamicResource UI4.Font.Size.Base}">

    <!-- UI4NavigationView 左侧导航栏的默认宿主模板（默认实现，不要在各工程重写一遍）。
         复制到 app/Views/ 后把 __APPNAME__ 换成工程名；数据项在 code-behind 里换成真实数据源。

         布局口径（几何与 QuickPanel 现网一致）：
           左栏与右内容 = 两张卡片，中间 12 px；右内容四角 12、顶部内缩 20；
           标题左边距 24（= 首卡 ItemMargin 20 + UI4GridView 内部 4），首卡用 ItemMargin=20；
           左栏/右内容圆角、导航项左右 4/5、上下 4 的内缩与主题重打由 code-behind 的 chrome 补丁负责。 -->

    <UserControl.Resources>
        <!-- 页面内容只服务这个案例；真实工程换成自己的页面 DataTemplate / UserControl。 -->
        <DataTemplate DataType="{x:Type views:NavigationPage}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 24 与第一张卡片的左缘对齐：GridView 的 ItemMargin 20 + 内部视口 4。 -->
                <StackPanel Grid.Row="0" Margin="24,0,4,4">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{DynamicResource App.Font.Size.Icon}" FontWeight="SemiBold"
                               Foreground="{DynamicResource UI4.Brush.Text}"/>
                    <TextBlock Text="{Binding Caption}" Margin="0,4,0,0"
                               FontSize="{DynamicResource App.Font.Size.Caption}"
                               Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                </StackPanel>

                <!-- 首卡左缘同样 24；真实页面把这块换成 UI4GridView（ItemMargin="20"）。 -->
                <Border Grid.Row="1" Margin="24,20,20,20"
                        Background="{DynamicResource UI4.Brush.Surface}"
                        BorderBrush="{DynamicResource UI4.Brush.BorderWeak}" BorderThickness="1"
                        CornerRadius="12" Padding="16">
                    <TextBlock Text="页面内容占位：真实工程换成 UI4GridView / 页面视图；卡片 ItemMargin=20，首卡左缘 24。"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource UI4.Brush.TextMuted}"
                               FontSize="{DynamicResource App.Font.Size.Medium}"/>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ui:UI4Grid>
        <Grid Margin="20">
            <!-- Nav 自身的颜色 DP 不跟令牌，五个 Item* 必须逐个接回（和 QuickPanel 现网一致）；
                 Background 必须透明，右内容面板的圆角缺口与 12 px 间距才露得出外层渐变。 -->
            <ui:UI4NavigationView x:Name="Nav"
                                  Background="Transparent"
                                  Header="功能分组"
                                  LeftPanelWidth="{DynamicResource App.Size.NavRail}"
                                  ItemFontSize="{DynamicResource App.Font.Size.Small}"
                                  ItemForeground="{DynamicResource UI4.Brush.Text}"
                                  ItemHoverColor="{DynamicResource UI4.Color.HoverOverlay}"
                                  ItemHoverForeground="{DynamicResource UI4.Color.TextForeground}"
                                  ItemPressedBackground="{DynamicResource UI4.Color.Surface}"
                                  ItemPressedForeground="{DynamicResource UI4.Color.TextForeground}"/>
        </Grid>
    </ui:UI4Grid>
</UserControl>
