<Window x:Class="IndexApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StartUI4Controls;assembly=StartUI4Controls"
        xmlns:views="clr-namespace:IndexApp.Views"
        Title="IndexApp" Width="1280" Height="780"
        MinWidth="{Binding ZoomFactor, Converter={StaticResource ZoomedSize}, ConverterParameter=W:960, FallbackValue=960}"
        MinHeight="{Binding ZoomFactor, Converter={StaticResource ZoomedSize}, ConverterParameter=H:640, FallbackValue=640}"
        Icon="AppIcon.ico"
        FontFamily="{DynamicResource UI4.Font.Family}"
        FontSize="{DynamicResource UI4.Font.Size.Base}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource UI4.Brush.Background}">

    <Window.Resources>
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource UI4.Brush.Icon}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UI4.Brush.BorderNormal}"/>
            <Setter Property="Padding" Value="4,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="{DynamicResource App.Font.Size.Small}"/>
            <EventSetter Event="Click" Handler="ColumnHeader_Click"/>
        </Style>
    </Window.Resources>

<Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/>
        </Grid.LayoutTransform>

        <ui:UI4Grid>
            <Grid Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 头部：标题 / 搜索 / 范围 / 刷新 / 设置。设置入口只保留齿轮一处。 -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="IndexApp" FontWeight="SemiBold"
                                   FontSize="{DynamicResource App.Font.Size.Lead}"
                                   Foreground="{DynamicResource UI4.Brush.Text}"/>
                        <TextBlock Text="文件名秒搜" FontSize="{DynamicResource App.Font.Size.Caption}"
                                   Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                    </StackPanel>

                    <ui:UI4TextBox x:Name="SearchBox" Grid.Column="1" Height="36" AutomationProperties.Name="搜索关键词"
                                   VerticalContentAlignment="Center"
                                   PlaceholderText="请输入需要搜索的内容"
                                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                   FontSize="{DynamicResource UI4.Font.Size.Base}"
                                   Margin="0,0,8,0"/>

                    <ui:UI4Button Grid.Column="2" x:Name="ScopeButton" Content="{Binding ScopeLabel}" AutomationProperties.Name="搜索范围"
                                  Height="{DynamicResource App.Size.Chip}" Padding="12,0"
                                  CornerRadius="{DynamicResource App.Radius.Chip}"
                                  FontSize="{DynamicResource App.Font.Size.Small}"
                                  GradientStart="{DynamicResource UI4.Color.OffBackground}"
                                  GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                                  HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                                  ToolTip="选择搜索目录；右键清除范围"
                                  Click="ScopeButton_Click"
                                  MouseRightButtonUp="ScopeButton_RightClick"
                                  Margin="0,0,8,0"/>

                    <ui:UI4Button Grid.Column="3" x:Name="RefreshButton" Content="刷新" AutomationProperties.Name="重建索引"
                                  Height="{DynamicResource App.Size.Chip}" Padding="12,0"
                                  CornerRadius="{DynamicResource App.Radius.Chip}"
                                  FontSize="{DynamicResource App.Font.Size.Small}"
                                  GradientStart="{DynamicResource UI4.Color.OffBackground}"
                                  GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                                  HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                                  ToolTip="重建索引（F5）"
                                  Click="RefreshButton_Click"
                                  Margin="0,0,8,0"/>

                    <ui:UI4Button Grid.Column="4" x:Name="SettingsBtn" AutomationProperties.Name="设置"
                                  Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                  Width="{DynamicResource App.Size.RoundButton}"
                                  Height="{DynamicResource App.Size.RoundButton}"
                                  Padding="0" CornerRadius="{DynamicResource App.Radius.RoundButton}"
                                  FontSize="{DynamicResource App.Font.Size.Icon}"
                                  GradientStart="{DynamicResource UI4.Color.OffBackground}"
                                  GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                                  HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                                  ToolTip="设置（Esc 关闭）"
                                  Click="SettingsBtn_Click"/>
                </Grid>

                <!-- 主体：分类 / 结果 / 预览 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="132"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" x:Name="CategoryPanel" Margin="0,0,12,0">
                        <TextBlock Text="分类" FontSize="{DynamicResource App.Font.Size.Medium}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource UI4.Brush.Icon}" Margin="0,0,0,8"/>

                        <ui:UI4Button Tag="All" Content="全部" Height="36" Padding="12,0"
                                      HorizontalContentAlignment="Left" Margin="0,0,0,4"
                                      CornerRadius="8" FontSize="{DynamicResource App.Font.Size.Medium}"
                                      GradientStart="{DynamicResource UI4.Color.OffBackground}"
                                      GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                                      HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                                      Click="Category_Click"/>
                        <ui:UI4Button Tag="Image" Content="图片" Height="36" Padding="12,0"
                                      HorizontalContentAlignment="Left" Margin="0,0,0,4"
                                      CornerRadius="8" FontSize="{DynamicResource App.Font.Size.Medium}"
                                      GradientStart="{DynamicResource UI4.Color.OffBackground}"
                                      GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                                      HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                                      Click="Category_Click"/>
                        <ui:UI4Button Tag="Document" Content="文档" Height="36" Padding="12,0"
                                      HorizontalContentAlignment="Left" Margin="0,0,0,4"
                                      CornerRadius="8" FontSize="{DynamicResource App.Font.Size.Medium}"
                                      GradientStart="{DynamicResource UI4.Color.OffBackground}"
                                      GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                                      HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                                      Click="Category_Click"/>
                        <ui:UI4Button Tag="Video" Content="视频" Height="36" Padding="12,0"
                                      HorizontalContentAlignment="Left" Margin="0,0,0,4"
                                      CornerRadius="8" FontSize="{DynamicResource App.Font.Size.Medium}"
                                      GradientStart="{DynamicResource UI4.Color.OffBackground}"
                                      GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                                      HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                                      Click="Category_Click"/>
                        <ui:UI4Button Tag="Audio" Content="音频" Height="36" Padding="12,0"
                                      HorizontalContentAlignment="Left" Margin="0,0,0,4"
                                      CornerRadius="8" FontSize="{DynamicResource App.Font.Size.Medium}"
                                      GradientStart="{DynamicResource UI4.Color.OffBackground}"
                                      GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                                      HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                                      Click="Category_Click"/>
                        <ui:UI4Button Tag="Mobile" Content="手机" Height="36" Padding="12,0"
                                      HorizontalContentAlignment="Left" Margin="0,0,0,4"
                                      CornerRadius="8" FontSize="{DynamicResource App.Font.Size.Medium}"
                                      GradientStart="{DynamicResource UI4.Color.OffBackground}"
                                      GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                                      HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                                      Click="Category_Click"/>
                        <ui:UI4Button Tag="Folder" Content="目录" Height="36" Padding="12,0"
                                      HorizontalContentAlignment="Left" Margin="0,0,0,12"
                                      CornerRadius="8" FontSize="{DynamicResource App.Font.Size.Medium}"
                                      GradientStart="{DynamicResource UI4.Color.OffBackground}"
                                      GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                                      HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                                      Click="Category_Click"/>

                        <TextBlock Text="选项" FontSize="{DynamicResource App.Font.Size.Medium}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource UI4.Brush.Icon}" Margin="0,0,0,8"/>
                        <ui:UI4CheckBox Content="区分大小写" IsChecked="{Binding CaseSensitive}" Margin="0,0,0,8"
                                        FontSize="{DynamicResource App.Font.Size.Small}"/>
                        <ui:UI4CheckBox Content="全字匹配" IsChecked="{Binding WholeWord}" Margin="0,0,0,8"
                                        FontSize="{DynamicResource App.Font.Size.Small}"/>
                        <ui:UI4CheckBox Content="通配符" IsChecked="{Binding Wildcard}" Margin="0,0,0,8"
                                        FontSize="{DynamicResource App.Font.Size.Small}"/>
                    </StackPanel>

                    <ui:UI4Panel Grid.Column="1" CornerRadius="12" ContentPadding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding CountText}" Margin="8,4,8,8"
                                       FontSize="{DynamicResource App.Font.Size.Small}"
                                       Foreground="{DynamicResource UI4.Brush.TextMuted}"
                                       TextTrimming="CharacterEllipsis"/>

                            <ListView Grid.Row="1" x:Name="ResultsList" AutomationProperties.Name="搜索结果"
                                      ItemsSource="{Binding Rows}"
                                      SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                      Background="Transparent" BorderThickness="0"
                                      Foreground="{DynamicResource UI4.Brush.Text}"
                                      FontSize="{DynamicResource App.Font.Size.Small}"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      ScrollViewer.CanContentScroll="True"
                                      SelectionMode="Single"
                                      MouseDoubleClick="ResultsList_MouseDoubleClick"
                                      PreviewMouseRightButtonDown="ResultsList_PreviewMouseRightButtonDown"
                                      ContextMenuOpening="ResultsList_ContextMenuOpening"
                                      ScrollViewer.ScrollChanged="ResultsList_ScrollChanged">
                                <ListView.ContextMenu>
                                    <ContextMenu Background="{DynamicResource UI4.Brush.Surface}"
                                                 Foreground="{DynamicResource UI4.Brush.Text}">
                                        <MenuItem Header="打开" Click="ContextOpen_Click"/>
                                        <MenuItem Header="打开所在目录" Click="ContextLocate_Click"/>
                                        <Separator/>
                                        <MenuItem Header="复制完整路径" Click="ContextCopyPath_Click"/>
                                    </ContextMenu>
                                </ListView.ContextMenu>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListViewItem}">
                                        <Setter Property="Height" Value="28"/>
                                        <Setter Property="Padding" Value="4,0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="{DynamicResource UI4.Brush.Text}"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ListViewItem}">
                                                    <Border x:Name="RowBorder"
                                                            Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}"
                                                            BorderThickness="0"
                                                            SnapsToDevicePixels="True">
                                                        <GridViewRowPresenter
                                                            Columns="{Binding View.Columns, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                                            x:Name="RowPresenter"
                                                            Content="{TemplateBinding Content}"
                                                            VerticalAlignment="Stretch"
                                                            SnapsToDevicePixels="True"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background"
                                                                    Value="{DynamicResource UI4.Brush.ListSelected}"/>
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource UI4.Brush.OnAccent}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="RowBorder" Property="Background"
                                                                    Value="{DynamicResource UI4.Brush.RowHoverBackground}"/>
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsSelected" Value="True"/>
                                                                <Condition Property="IsMouseOver" Value="True"/>
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="RowBorder" Property="Background"
                                                                    Value="{DynamicResource UI4.Brush.ListSelected}"/>
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="文件名" Width="210">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="文件路径" Width="300">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Folder}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"
                                                               ToolTip="{Binding Path}"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="文件大小" Width="90">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding SizeText}" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="修改时间" Width="130">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ModifiedText}" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListViewItem}}}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </ui:UI4Panel>

                    <ui:UI4Panel Grid.Column="2" Margin="12,0,0,0" CornerRadius="12" ContentPadding="20">
                        <Grid Margin="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding SelectedRow.Name, FallbackValue=未选择文件}"
                                       FontSize="{DynamicResource App.Font.Size.Medium}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource UI4.Brush.Text}"
                                       TextTrimming="CharacterEllipsis" Margin="0,0,0,12"
                                       ToolTip="{Binding SelectedRow.Path}"/>

                            <Grid Grid.Row="1">
                                <Image Source="{Binding PreviewImage}" AutomationProperties.Name="预览图片"
                                       Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                       Stretch="Uniform" MaxHeight="240" HorizontalAlignment="Center"
                                       VerticalAlignment="Top" Margin="4"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="{Binding HasPreviewText, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                                              Padding="4,4,4,4">
                                    <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap"
                                               FontFamily="Consolas, Microsoft YaHei UI"
                                               FontSize="{DynamicResource App.Font.Size.Small}"
                                               Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                                </ScrollViewer>
                                <TextBlock Text="暂无预览" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="{Binding ShowNoPreview, Converter={StaticResource BoolToVis}, FallbackValue=Visible}"
                                           Foreground="{DynamicResource UI4.Brush.TextMuted}"
                                           FontSize="{DynamicResource App.Font.Size.Medium}"/>
                            </Grid>

                            <TextBlock Grid.Row="2" Text="{Binding PreviewMeta}" Margin="0,16,0,0"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource App.Font.Size.Caption}"
                                       Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                        </Grid>
                    </ui:UI4Panel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding IndexStatusText}"
                               FontSize="{DynamicResource App.Font.Size.Caption}"
                               Foreground="{DynamicResource UI4.Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding SortText}" Margin="12,0"
                               FontSize="{DynamicResource App.Font.Size.Caption}"
                               Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                    <TextBlock Grid.Column="2" x:Name="ThemeFooter" Text=""
                               FontSize="{DynamicResource App.Font.Size.Caption}"
                               Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                </Grid>
            </Grid>
        </ui:UI4Grid>

        <Grid x:Name="SettingsHost" Panel.ZIndex="90"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Border Background="#80000000" MouseLeftButtonDown="SettingsOverlay_BackgroundClick"/>
            <Border Background="{DynamicResource UI4.Brush.Surface}"
                    BorderBrush="{DynamicResource UI4.Brush.BorderNormal}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    Width="440" MaxHeight="620"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <views:SettingsOverlay DataContext="{Binding}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
