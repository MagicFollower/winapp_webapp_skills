<Window x:Class="QuickPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:StartUI4Controls;assembly=StartUI4Controls"
        xmlns:views="clr-namespace:QuickPanel.Views"
        xmlns:m="clr-namespace:QuickPanel.Models"
        xmlns:vm="clr-namespace:QuickPanel.ViewModels"
        Title="快捷工具面板" Width="1120" Height="760"
        MinWidth="{Binding ZoomFactor, Converter={StaticResource ZoomedSize}, ConverterParameter=W:860, FallbackValue=860}"
        MinHeight="{Binding ZoomFactor, Converter={StaticResource ZoomedSize}, ConverterParameter=H:560, FallbackValue=560}"
        Icon="AppIcon.ico"
        FontFamily="{DynamicResource UI4.Font.Family}"
        FontSize="{DynamicResource UI4.Font.Size.Base}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="{DynamicResource UI4.Brush.Background}">

    <Window.Resources>
        <!-- ── 卡片上的标签胶囊：尺寸与圆角取 App.Size.Chip / App.Radius.Chip（随字号长高），
             颜色一律取令牌，切档一起走。Radius 必须是 CornerRadius 类型的资源。 ─────── -->
        <Style x:Key="Chip" TargetType="Border">
            <Setter Property="Height" Value="{DynamicResource App.Size.Chip}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource App.Radius.Chip}"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="{DynamicResource UI4.Brush.HoverOverlay}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource UI4.Brush.BorderWeak}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource App.Font.Size.Caption}"/>
            <Setter Property="Foreground" Value="{DynamicResource UI4.Brush.TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 需要被看见的两类标签（危险性、本机未找到）用强调色，其余保持次要观感 -->
        <Style x:Key="ChipAlert" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="BorderBrush" Value="{DynamicResource UI4.Brush.Accent}"/>
            <Setter Property="Background" Value="{DynamicResource UI4.Brush.SelectedOverlay}"/>
        </Style>
        <Style x:Key="ChipAlertText" TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
            <Setter Property="Foreground" Value="{DynamicResource UI4.Brush.Accent}"/>
        </Style>
        <!-- 分组标签要读得清但不抢危险标签的眼，所以只提一档到正文色 -->
        <Style x:Key="ChipGroupText" TargetType="TextBlock" BasedOn="{StaticResource ChipText}">
            <Setter Property="Foreground" Value="{DynamicResource UI4.Brush.Text}"/>
        </Style>
        <!-- 已收藏：只描强调色边、不填 SelectedOverlay（那种底色是留给危险与"本机未找到"的眼） -->
        <Style x:Key="ChipFavorite" TargetType="Border" BasedOn="{StaticResource Chip}">
            <Setter Property="BorderBrush" Value="{DynamicResource UI4.Brush.Accent}"/>
        </Style>

        <!-- ── 一张卡片 = 一个系统入口：功能名 / 命令原文（等宽）/ 介绍 / 标签 ──────
             命令是本面板的主信息之一，用排印键 UI4.Font.Size.Code 而不是正文字号。
             字号一律不写字面数字（判据：grep 'FontSize="[0-9]' 输出为空）。 -->
        <DataTemplate x:Key="ToolCard" DataType="{x:Type m:ToolItem}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题右侧固定让出 26 px 给下面的拖动标记。不分屏开关：切到收藏页时标题若突然缩进
                     会整片重排，槽位常驻的代价（其它页少 26 px 标题宽）比那个抖动小。 -->
                <TextBlock Grid.Row="0" Text="{Binding Title}" Margin="0,0,26,0"
                           FontSize="{DynamicResource App.Font.Size.Lead}" FontWeight="SemiBold"
                           Foreground="{DynamicResource UI4.Brush.Text}"
                           TextTrimming="CharacterEllipsis"/>

                <!-- 拖动标记：只在收藏页出现（IsReorderable = 收藏节 且 搜索框为空——搜索态下"拖到这一格"
                     落到全表顺序上有歧义）。拖动的手势与动画都挂在下面 UI4GridView 的 Preview 事件上，
                     这里只留一个可命中的 22x22 矩形和 Tag（宿主按 Tag 在卡片模板里找它、按它的屏幕矩形判定
                     "这一下按在标记上"）——不再依赖子元素的 MouseLeftButtonDown 冒泡与子元素捕获。
                     字形 E8CB 是 ↑↓（拿 GlyphTypeface 渲出来对着看定的，不是汉堡包也不是省略号）。
                     用 TextBlock 而不是套一层 Border：Border 没有自动化 peer，读屏与按名字找元素的脚本
                     都拿它没办法；TextBlock 给了 Background 就整块可命中，不需要再垫一层。
                     AutomationProperties.Name 同理——内容只是私有区码位，不写名字就认不出这是干什么的。 -->
                <TextBlock Grid.Row="0" Text="&#xE8CB;" Width="22" Height="22" Margin="0,0,2,0"
                           HorizontalAlignment="Right" VerticalAlignment="Top"
                           TextAlignment="Center" Padding="0,2,0,0"
                           Background="Transparent" Cursor="SizeAll"
                           Tag="FavoriteGrip"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="{DynamicResource App.Font.Size.Small}"
                           Foreground="{DynamicResource UI4.Brush.TextMuted}"
                           ToolTip="按住拖动可调整收藏顺序"
                           AutomationProperties.Name="拖动排序"
                           Visibility="{Binding DataContext.IsReorderable, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}"/>

                <Border Grid.Row="1" Margin="0,8,0,0" Padding="8,4" CornerRadius="6"
                        Background="{DynamicResource UI4.Brush.OffBackground}"
                        BorderBrush="{DynamicResource UI4.Brush.BorderWeak}" BorderThickness="1"
                        ToolTipService.ShowDuration="20000">
                    <Border.ToolTip>
                        <ToolTip MaxWidth="720" Padding="0" Background="Transparent" BorderThickness="0">
                            <Border Background="{DynamicResource UI4.Brush.Surface}"
                                    BorderBrush="{DynamicResource UI4.Brush.BorderNormal}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource App.Radius.Chip}"
                                    Padding="12,10">
                                <StackPanel MaxWidth="660">
                                    <TextBlock Text="{Binding PlacementTarget.DataContext.Command, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                               FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                                               FontSize="{DynamicResource UI4.Font.Size.Code}"
                                               Foreground="{DynamicResource UI4.Brush.Accent}"
                                               TextWrapping="Wrap"/>
                                    <Border Height="1" Margin="0,8,0,8"
                                            Background="{DynamicResource UI4.Brush.BorderWeak}"/>
                                    <TextBlock Text="{Binding PlacementTarget.DataContext.DetailTipBody, RelativeSource={RelativeSource AncestorType=ToolTip}}"
                                               FontSize="{DynamicResource App.Font.Size.Medium}"
                                               Foreground="{DynamicResource UI4.Brush.Text}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </ToolTip>
                    </Border.ToolTip>
                    <TextBlock Text="{Binding Command}"
                               FontFamily="Cascadia Mono, Consolas, Courier New, monospace"
                               FontSize="{DynamicResource UI4.Font.Size.Code}"
                               Foreground="{DynamicResource UI4.Brush.Accent}"
                               TextTrimming="CharacterEllipsis"/>
                </Border>

                <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="{Binding Description}"
                           FontSize="{DynamicResource App.Font.Size.Medium}"
                           Foreground="{DynamicResource UI4.Brush.TextMuted}"
                           TextWrapping="Wrap"/>

                <!-- ── 第 4 行：标签 + 收藏钮 ─────────────────────────────
                     收藏钮只在鼠标悬浮到这张卡上时出现（外层 Grid 的 Visibility 走容器的 IsMouseOver），
                     但右下角那块位置一直给它留着（WrapPanel 右侧让出 48 px）——不然悬浮那一刻
                     标签会被挤得重排，看着像卡片在跳。 -->
                <Grid Grid.Row="3" Margin="0,4,0,0">
                    <WrapPanel Margin="0,0,48,0">
                        <!-- 已收藏排第一个：它是悬浮星标唯一的写入口留下的痕迹，要能一眼核对 -->
                        <Border Style="{StaticResource ChipFavorite}"
                                Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource ChipGroupText}" Text="已收藏"/>
                        </Border>
                        <!-- 所属大类：只在跨组屏（全部工具、收藏）与搜索中显示（判据在 ToolSection.ShowGroupTags）。
                             卡片自己的 DataContext 是 ToolItem，所以这一条要经 ListBox 祖先取回分组视图的状态。 -->
                        <Border Style="{StaticResource Chip}"
                                Visibility="{Binding DataContext.ShowGroupTags, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource ChipGroupText}" Text="{Binding GroupTitle}"/>
                        </Border>
                        <Border Style="{StaticResource Chip}">
                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding PlatformChip}"/>
                        </Border>
                        <Border Style="{StaticResource Chip}"
                                Visibility="{Binding ShowAdminChip, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding AdminChip}"/>
                        </Border>
                        <Border Style="{StaticResource Chip}"
                                Visibility="{Binding ShowEditionChip, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource ChipText}" Text="{Binding EditionChip}"/>
                        </Border>
                        <Border Style="{StaticResource ChipAlert}"
                                Visibility="{Binding ShowDangerChip, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource ChipAlertText}" Text="{Binding DangerChip}"/>
                        </Border>
                        <Border Style="{StaticResource ChipAlert}"
                                Visibility="{Binding ShowMissingChip, Converter={StaticResource BoolToVis}}">
                            <TextBlock Style="{StaticResource ChipAlertText}" Text="{Binding MissingChip}"/>
                        </Border>
                    </WrapPanel>

                    <!-- 悬浮才出现的收藏钮：两个方向各一颗星、互斥显示（空心=还没收藏，实心=已在收藏）。
                         分成两个按钮而不是一个按钮换文案，是因为字形与 ToolTip 都要跟着状态走，
                         用一个按钮就得再写一个"码位+提示"的转换器，判据散成两处。
                         星号码位是拿 GlyphTypeface 渲出来对着看定的：E734 空心星、E735 实心星
                         （E8FA/E8B0 分别是"添加用户"与指针，不是星）。
                         AutomationProperties.Name 是给读屏与自动化脚本的：按钮内容只有一个字形，
                         UIA 名字若不走这里就只剩一个私有区码位，按名字找按钮的脚本会全废。
                         命令走 Window 祖先取视图模型（卡片在窗口可视树里，不像 Popup 那样断链），
                         参数是这张卡自己。按钮吃掉左键，所以点它不会连带触发卡片的"单击即执行"。 -->
                    <Grid HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Visibility="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource BoolToVis}}">
                        <ui:UI4Button Width="{DynamicResource App.Size.RoundButton}"
                                      Height="{DynamicResource App.Size.RoundButton}"
                                      Padding="0" CornerRadius="{DynamicResource App.Radius.RoundButton}"
                                      FontFamily="Segoe MDL2 Assets" Content="&#xE734;"
                                      FontSize="{DynamicResource App.Font.Size.Icon}"
                                      GradientStart="{DynamicResource UI4.Color.OffBackground}"
                                      GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                                      HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                                      ToolTip="添加至收藏"
                                      AutomationProperties.Name="添加至收藏"
                                      Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"
                                      Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                        <ui:UI4Button Width="{DynamicResource App.Size.RoundButton}"
                                      Height="{DynamicResource App.Size.RoundButton}"
                                      Padding="0" CornerRadius="{DynamicResource App.Radius.RoundButton}"
                                      FontFamily="Segoe MDL2 Assets" Content="&#xE735;"
                                      FontSize="{DynamicResource App.Font.Size.Icon}"
                                      GradientStart="{DynamicResource UI4.Color.OffBackground}"
                                      GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                                      HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                                      ToolTip="从收藏移除"
                                      AutomationProperties.Name="从收藏移除"
                                      Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}"
                                      Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ── 右栏的常驻容器：各分组（含全部工具与收藏）的视图叠在同一格里，切换只翻各节的 Visibility ──
             导航项的 Content 全部指向同一个 SectionShell 实例，Content 不变 → 模板不重建 →
             已经实体化过的卡片容器留着。UniformGrid 不虚拟化，重建一次「全部工具」要占住
             UI 线程 190 ms（实测），而数据是固定的，没有理由每次切换再建一遍。 -->
        <DataTemplate DataType="{x:Type vm:SectionShell}">
            <ItemsControl ItemsSource="{Binding Sections}"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                          Focusable="False" FocusVisualStyle="{x:Null}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </DataTemplate>

        <!-- ── 一个分组在右栏的全部内容（隐式模板，由上面那层 ItemsControl 按类型取用）── -->
        <DataTemplate DataType="{x:Type vm:ToolSection}">
            <Grid Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 标题左边与第一张卡片对齐：卡片容器左边 = 面板左边 + 24（ItemMargin 20 + 内部视口 4 px）；
                     原来只留 4，标题会贴面板左沿。 -->
                <StackPanel Grid.Row="0" Margin="24,0,4,4">
                    <TextBlock Text="{Binding Title}"
                               FontSize="{DynamicResource App.Font.Size.Icon}" FontWeight="SemiBold"
                               Foreground="{DynamicResource UI4.Brush.Text}"/>
                    <TextBlock Text="{Binding MatchCaption}" Margin="0,4,0,0"
                               FontSize="{DynamicResource App.Font.Size.Caption}"
                               Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                </StackPanel>

                <!-- ItemWidth 是"算列数的基准单元"而不是卡片宽度；ItemMargin 同时是
                     悬浮放大的余量（左右 ≥ 10）与投影外溢空间（≥ ShadowDepth 8 + Blur 12 = 20），
                     所以取 20——压成 0 的那一刻投影切边和"悬浮没反应"会同时出现。
                     ItemHeight 给 NaN（不写死）：卡片高度由内容决定，字号拉到 28 时介绍与标签
                     才不会被切掉；写死 176 在默认字号下好看，一档上去就整片截断。
                     IsSynchronizedWithCurrentItem 必须显式关掉：默认会自动同步视图的当前项，
                     于是搜索一改过滤，首项就被"选中"并触发执行，等于替用户点了卡片。
                     拖动排序的输入挂在网格的 Preview 事件上并用网格自身捕获鼠标：即便某个子元素
                     吃掉了冒泡事件或拿走了焦点，手势仍从源头看得到；落点也只看几何（最近槽位），
                     不要求命中卡片内容。 -->
                <ui:UI4GridView Grid.Row="1" x:Name="ToolGrid"
                                ItemsSource="{Binding ItemsView}"
                                ItemTemplate="{StaticResource ToolCard}"
                                ItemWidth="260" ItemHeight="NaN"
                                ItemMargin="20" ItemPadding="16" ItemCornerRadius="12"
                                ShadowDepth="8" ShadowBlurRadius="12" ShadowOpacity="0.28"
                                HoverScale="1.03"
                                VerticalAlignment="Top"
                                IsSynchronizedWithCurrentItem="False"
                                SelectionChanged="ToolGrid_SelectionChanged"
                                PreviewMouseLeftButtonDown="ToolGrid_PreviewMouseLeftButtonDown"
                                PreviewMouseMove="ToolGrid_PreviewMouseMove"
                                PreviewMouseLeftButtonUp="ToolGrid_PreviewMouseLeftButtonUp"
                                LostMouseCapture="ToolGrid_LostMouseCapture"
                                Margin="0,8,0,0"/>

                <!-- 空态文案由 Section 给（成因不同说法不同：收藏是"还没加、怎么加"，搜索是"词没命中"），
                     模板里不写第二份判断 -->
                <TextBlock Grid.Row="1" Text="{Binding EmptyHint}"
                           Visibility="{Binding HasNoMatches, Converter={StaticResource BoolToVis}}"
                           Foreground="{DynamicResource UI4.Brush.TextMuted}"
                           FontSize="{DynamicResource App.Font.Size.Medium}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- 标题栏不要自绘：窗口里出现过 UI4 控件，库就在 Loaded 时按 DWM 把原生标题栏染好。
         全局缩放挂在根内容的 LayoutTransform 上；已知边界是 Popup（下拉浮层、ToolTip 浮条）
         住在自己的可视根里，不吃这层变换。顶部的收藏提示条是普通子元素，所以它跟着缩放一起长。 -->
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"/>
        </Grid.LayoutTransform>

        <ui:UI4Grid>
            <!-- 间距刻度只用 4 的倍数：4 / 8 / 12 / 16 / 20 / 24 / 32 -->
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 工具条：标题 + 搜索 + 齿轮。设置只留这一处入口，窗口上不再摆同义按钮 -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="快捷工具面板"
                                   FontSize="{DynamicResource App.Font.Size.Icon}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource UI4.Brush.Text}"/>
                        <TextBlock Text="点卡片即执行，收的是 Win10 与 Win11 都有的系统入口"
                                   Margin="0,4,0,0"
                                   FontSize="{DynamicResource App.Font.Size.Caption}"
                                   Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                    </StackPanel>

                    <ui:UI4TextBox Grid.Column="1" Width="{DynamicResource App.Size.SearchBox}" Height="36" VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   PlaceholderText="搜索功能或命令，如 服务 / msc / 防火墙"
                                   ShowClearButton="True"
                                   Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"/>

                    <ui:UI4Button Grid.Column="2" x:Name="SettingsBtn" VerticalAlignment="Center"
                                  Content="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                  Width="{DynamicResource App.Size.RoundButton}"
                                  Height="{DynamicResource App.Size.RoundButton}"
                                  Padding="0" CornerRadius="{DynamicResource App.Radius.RoundButton}"
                                  FontSize="{DynamicResource App.Font.Size.Icon}"
                                  GradientStart="{DynamicResource UI4.Color.OffBackground}"
                                  GradientEnd="{DynamicResource UI4.Color.OffBackground}"
                                  HoverBackground="{DynamicResource UI4.Brush.AccentDark}"
                                  ToolTip="设置（Esc 关闭）"
                                  Click="SettingsBtn_Click"/>
                </Grid>

                <!-- 左栏分组导航。这六个颜色 DP 在库里是字面默认值、不跟令牌，
                     深色档下会黑字压黑底，所以逐个显式接回去。
                     Background=Transparent：右栏内容面板的圆角缺口要露出外层渐变，
                     否则缺口底下仍是 NavigationView 的同一块底色，看起来还是直角。 -->
                <ui:UI4NavigationView Grid.Row="1" x:Name="Nav"
                                      Background="Transparent"
                                      Header="功能分组" LeftPanelWidth="{DynamicResource App.Size.NavRail}"
                                      ItemFontSize="{DynamicResource App.Font.Size.Small}"
                                      ItemForeground="{DynamicResource UI4.Brush.Text}"
                                      ItemHoverColor="{DynamicResource UI4.Color.HoverOverlay}"
                                      ItemHoverForeground="{DynamicResource UI4.Color.TextForeground}"
                                      ItemPressedBackground="{DynamicResource UI4.Color.Surface}"
                                      ItemPressedForeground="{DynamicResource UI4.Color.TextForeground}"/>

                <!-- 页脚：最近一次执行结果 + 数据源规模 + 当前生效档 -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                               FontSize="{DynamicResource App.Font.Size.Caption}"
                               Foreground="{DynamicResource UI4.Brush.TextMuted}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                               Text="{Binding CatalogCaption}"
                               FontSize="{DynamicResource App.Font.Size.Caption}"
                               Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                    <TextBlock Grid.Column="2" x:Name="ThemeFooter" Margin="16,0,0,0"
                               VerticalAlignment="Center" Text="主题: —"
                               FontSize="{DynamicResource App.Font.Size.Caption}"
                               Foreground="{DynamicResource UI4.Brush.TextMuted}"/>
                </Grid>
            </Grid>
        </ui:UI4Grid>

        <!-- 顶部提示条：收藏这类"点了就要当场看见"的动作走这里，页脚那行留痕但不该指望用户回头看屏幕底边。
             定时自己收（计时器在视图模型里），所以它不是模态框——不抢焦点、不吃点击，
             "模态框只留给错误报告"这条不变量不松动。挂在根 Grid 内，因此跟着全局缩放一起长。 -->
        <Border Panel.ZIndex="80" MaxWidth="520" Margin="0,16,0,0" Padding="16,8"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Visibility="{Binding IsToastOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                Background="{DynamicResource UI4.Brush.Surface}"
                BorderBrush="{DynamicResource UI4.Brush.Accent}" BorderThickness="1"
                CornerRadius="{DynamicResource App.Radius.Chip}">
            <TextBlock Text="{Binding ToastText}" TextWrapping="Wrap" TextAlignment="Center"
                       FontSize="{DynamicResource App.Font.Size.Small}"
                       Foreground="{DynamicResource UI4.Brush.Text}"/>
        </Border>

        <!-- 设置浮层：遮罩吃掉点击，卡片内容交给 SettingsOverlay；开合状态只有 IsSettingsOpen 一处 -->
        <Grid x:Name="SettingsHost" Panel.ZIndex="90"
              Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
            <Border Background="#80000000" MouseLeftButtonDown="SettingsOverlay_BackgroundClick"/>
            <Border Background="{DynamicResource UI4.Brush.Surface}"
                    BorderBrush="{DynamicResource UI4.Brush.BorderNormal}"
                    BorderThickness="1" CornerRadius="12" Padding="24"
                    Width="440" MaxHeight="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <views:SettingsOverlay DataContext="{Binding}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
